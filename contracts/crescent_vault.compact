pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * ============================================================================
 * CRESCENT VAULT — ZERO-KNOWLEDGE SOLVENCY & SHIELDED ALLOWANCE
 * ============================================================================
 *
 * PRIVACY SPECIFICATION:
 * 1. PUBLIC LEDGER STATE (On-Chain Consensus):
 *    - `counter`: Public tally of verified solvency assertions.
 *    - `totalUpdates`: Total count of state transitions submitted to ledger.
 *
 * 2. PRIVATE WITNESS (Off-Chain Client Prover):
 *    - `get_increment_secret()`: Secret reserve balance / allowance witness
 *      provided by the local Lace wallet. Never published to the mempool or ledger.
 *
 * 3. DELIBERATE DISCLOSURE & ZK PROOF:
 *    - The user computes a zero-knowledge proof in the browser proving:
 *        witness >= disclosedStep
 *        witness > 0
 *    - The exact witness balance remains completely SHIELDED.
 *    - Only the verified transition is deliberately disclosed to consensus.
 * ============================================================================
 */

// Public state maintained on the Midnight ledger
export ledger counter: Uint<32>;
export ledger totalUpdates: Uint<32>;

// Private witness queried exclusively within the browser's local ZK proof engine
witness get_increment_secret(): Uint<32>;

// Circuit that verifies private solvency constraint and updates public state
export circuit increment_counter(disclosedStep: Uint<32>): [] {
    // 1. Fetch private witness from local client memory (never leaves browser unshielded)
    const secret = get_increment_secret();

    // 2. Cryptographic constraint evaluation (zero-knowledge proof generated locally)
    assert(secret == disclosedStep, "Constraint failed: Private witness must satisfy threshold");
    assert(secret > 0, "Solvency reserve must be strictly positive");

    // 3. Deliberately disclose public accumulator update without revealing secret origin
    counter = (counter + disclose(disclosedStep)) as Uint<32>;
    totalUpdates = (totalUpdates + 1) as Uint<32>;
}
